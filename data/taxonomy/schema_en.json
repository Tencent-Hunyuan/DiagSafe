{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagSafe English Taxonomy",
  "description": "English field names, category names, and safety label specifications for DiagSafe.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "category_code",
      "category_name",
      "definition",
      "general_standard",
      "detailed_rules"
    ],
    "properties": {
      "category_code": {
        "type": "string",
        "pattern": "^OSS-(?:0[1-9]|1[01])$"
      },
      "category_name": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "l1",
          "l2",
          "l3"
        ],
        "properties": {
          "l1": {
            "type": "string",
            "minLength": 1
          },
          "l2": {
            "type": "string",
            "minLength": 1
          },
          "l3": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "definition": {
        "type": "string",
        "minLength": 1
      },
      "general_standard": {
        "type": "string",
        "minLength": 1
      },
      "detailed_rules": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
